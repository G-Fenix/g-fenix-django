<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for url in urls %}
  <url>
    <loc>{{ base }}{{ url.path }}</loc>
    <lastmod>{{ url.lastmod }}</lastmod>
    <changefreq>{{ url.freq }}</changefreq>
    <priority>{{ url.priority }}</priority>
    <xhtml:link rel="alternate" hreflang="en"       href="{{ base }}{{ url.path }}"/>
    <xhtml:link rel="alternate" hreflang="tr"       href="{{ base }}/tr{{ url.path }}"/>
    <xhtml:link rel="alternate" hreflang="es"       href="{{ base }}/es{{ url.path }}"/>
    <xhtml:link rel="alternate" hreflang="ca"       href="{{ base }}/ca{{ url.path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ base }}{{ url.path }}"/>
  </url>
{% endfor %}
</urlset>
